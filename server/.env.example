# Copy this file to .env.local for local development (never commit .env.local).
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers). No database name needed in the URI.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=finance-tracker
# finance_dev for local development/testing, finance_prod for live data.
MONGODB_DB=finance_dev

# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173

APP_TIMEZONE=Asia/Dubai

# Used only by `npm run seed` to create the two users (hashed with bcrypt, never stored in plain text).
SEED_SAJIN_PASSWORD=
SEED_ABHIRAMI_PASSWORD=
