# Copy this file to .env.local for local development (never commit .env.local).
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers). No database name needed in the URI.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=finance-tracker
# finance_dev for local development/testing, finance_prod for live data.
MONGODB_DB=finance_dev

# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173

APP_TIMEZONE=Asia/Dubai

# Optional. Only if your network blocks DNS SRV lookups (error "querySrv ECONNREFUSED").
# The server already retries with 1.1.1.1 and 8.8.8.8 automatically.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Public URL of the frontend, used for links in invitation and reminder emails (defaults to CLIENT_ORIGIN).
# APP_URL=http://localhost:5173

# Email (partner invitations, bill reminders). Without SMTP_HOST, emails are printed to the server log
# and the app shows the invitation link so you can share it yourself.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM=Household Finance <you@gmail.com>

# Daily reminder emails: Vercel Cron calls /api/cron/reminders with this as a Bearer token.
# CRON_SECRET=long-random-string

# Set to false to stop new sign-ups (existing users and partner invitations keep working).
# ALLOW_REGISTRATION=true

# AI chat. Set the key in Vercel → Settings → Environment Variables; never commit it.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna
# AI_DAILY_LIMIT=30
